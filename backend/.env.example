DATABASE_URL=postgresql://inventory_user:inventory_pass_dev@localhost:5440/inventory_db
JWT_ACCESS_SECRET=min-32-chars-change-me-in-production
JWT_REFRESH_SECRET=different-secret-min-32-chars-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Set ONLY if a reverse proxy/load balancer/ingress sits in front of this
# process in this environment. Empty/"false" = trust nothing (safe when this
# process is reached directly).
#
# Prefer a HOP COUNT ("1" for exactly one proxy) or the proxy's exact
# IP/CIDR ("10.0.0.5" or "10.0.0.0/24") — whichever matches your actual
# infrastructure. AVOID "true": it trusts every hop and reads the
# LEFTMOST X-Forwarded-For entry as the client IP, which a client can
# forge by prepending fake addresses of its own if the proxy in front of
# you appends to that header rather than replacing it outright. A hop
# count trusts only the Nth entry from the RIGHT (the one your own,
# known proxy is the one that could have written), so a client-forged
# prefix is ignored regardless of how many fake hops it adds. Wrong here
# means req.ip (used by rate limiting AND audit logs) is either the
# proxy's IP for everyone, or spoofable by any client. See
# docs/security-checklist-deploy.md.
TRUST_PROXY=

# Password hashing — generate with: openssl rand -base64 48
PASSWORD_PEPPER=

# Mail — "fake" logs instead of sending; production requires "smtp"
MAIL_DRIVER=fake
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Development seed password (must satisfy the password policy)
SEED_ADMIN_PASSWORD=
